# Skopiuj ten plik jako .env.local i wpisz swoje wartości.
# Klucz z https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Id modelu z https://openrouter.ai/models
OPENROUTER_MODEL=
# Wspólne hasło warsztatowe do wejścia na czat
CHAT_PASSWORD=
# Losowy sekret do podpisywania sesji (min. 32 znaki), np.:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
